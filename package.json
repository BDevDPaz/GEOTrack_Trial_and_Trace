{
  "name": "w-tracker",
  "author": "BDevDPaz",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:deadcode": "knip",
    "lint:cycles": "madge --circular --extensions ts,tsx src app",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "jest --coverage --no-watchman",
    "audit:gm": "tsx scripts/audit/gold-master.ts",
    "audit:time": "tsx scripts/audit/audits/time.audit.ts",
    "audit:db": "tsx scripts/audit/audits/database.audit.ts",
    "audit:logs": "tsx scripts/audit/audits/logger.audit.ts",
    "audit:concurrency": "tsx scripts/audit/audits/concurrency.audit.ts",
    "audit:geo": "tsx scripts/audit/audits/geofencing.audit.ts",
    "audit:payroll": "tsx scripts/audit/audits/payroll.audit.ts",
    "audit:ui": "tsx scripts/audit/audits/ui.audit.ts",
    "audit:android": "tsx scripts/audit/audits/android.audit.ts",
    "audit:security": "tsx scripts/audit/audits/security.audit.ts",
    "gm": "npm run typecheck && npm run lint:strict && npm run format:check && npm run test && npm run audit:gm",
    "gm:deep": "npm run gm && npm run lint:cycles && npx expo-doctor",
    "audit:deadcode": "npm run lint:deadcode"
  },
  "dependencies": {
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "babel-preset-expo": "~54.0.10",
    "dayjs": "^1.11.21",
    "escape-html": "^1.0.3",
    "expo": "~54.0.37",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-mail-composer": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-web-browser": "~15.0.11",
    "i18n-js": "^4.5.1",
    "lucide-react-native": "^0.563.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/escape-html": "^1.0.4",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-expo": "~54.0.18",
    "knip": "^6.25.0",
    "madge": "^8.0.0",
    "metro": "^0.83.1",
    "prettier": "^3.9.4",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.1": true
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  }
}
