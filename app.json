{
  "expo": {
    "name": "WTracker Trial_and_TraceT",
    "slug": "GEOT_TandT",
    "scheme": "geotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bdevdpaz.geotracktrialandtrace",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "GEOTrack_Trial_and_Trace necesita tu ubicación para registrar el inicio y fin de tus jornadas laborales de forma precisa.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GEOTrack_Trial_and_Trace requiere acceso a tu ubicación en segundo plano para detectar automáticamente cuando entras o sales de los sitios de trabajo mediante geocercas.",
        "UIUserInterfaceStyle": "Dark"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.bdevdpaz.geotracktrialandtrace",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a GEOTrack_Trial_and_Trace usar tu ubicación en segundo plano para las automatizaciones de Auto Check-in y Auto Check-out.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#D4AF37",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-background-task",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1f32bb30-083d-49f1-8ebf-65c21e3bbb37"
      }
    },
    "owner": "b_dpaz"
  }
}
